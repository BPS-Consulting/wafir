{
  "name": "chrome-extension",
  "private": true,
  "version": "0.1.0",
  "description": "Wafir Issue Reporter Chrome Extension",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --mode injector && vite build --mode main-world",
    "dev": "vite build --watch",
    "check-types": "tsc --noEmit",
    "format": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\""
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "wafir": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.324",
    "@types/js-yaml": "^4.0.9",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}

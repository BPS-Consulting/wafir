{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "format": {
      "dependsOn": ["^format"],
      "inputs": [
        "**/*.{js,jsx,ts,tsx,md,json,yml,yaml}",
        "!.next/**",
        "!dist/**",
        "!build/**",
        "!node_modules/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate:swagger": {
      "outputs": ["swagger.json"],
      "cache": true
    },
    "generate:api": {
      "dependsOn": ["bridge#generate:swagger"],
      "outputs": ["src/api/index.ts"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "outputs": ["coverage/**"]
    }
  }
}
